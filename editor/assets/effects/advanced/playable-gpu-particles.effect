// Task 005 M5.2 analytical billboard and velocity-stretched billboard shader.
// a_position: local spawn position; a_normal: initial velocity;
// a_texCoord: quad corner (-1..1); a_tangent.x: birth phase (0..1).
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: gpu-particle-vs:vert
      frag: gpu-particle-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        u_simParams: { value: [0, 3, 0.05, 0], editor: { visible: false } }
        u_gravity: { value: [0, -9.8, 0, 0], editor: { visible: false } }
        mainColor: { value: [1, 0.8, 0.3, 1], editor: { type: color } }
        u_stretchParams: { value: [0, 1, 0, 0], editor: { visible: false } }
        u_collisionPlane: { value: [0, 0, 0.5, 0], editor: { visible: false } }
        u_collisionSphere: { value: [0, 0, 0, 0], editor: { visible: false } }
        u_sphereParams: { value: [0, 1, 0.5, 0], editor: { visible: false } }
    - vert: gpu-particle-vs:vert
      frag: gpu-particle-fs:frag
      phase: deferred-forward
      propertyIndex: 0
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram gpu-particle-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  uniform ParticleData {
    vec4 u_simParams;  // time, lifetime, size, drag
    vec4 u_gravity;
    vec4 mainColor;
    vec4 u_stretchParams;
    vec4 u_collisionPlane;
    vec4 u_collisionSphere;
    vec4 u_sphereParams;
  };

  out vec2 v_uv;
  out float v_alpha;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    float life = max(u_simParams.y, 0.001);
    float age = mod(max(u_simParams.x + In.tangent.x * life, 0.0), life);
    float t = age;
    float drag = max(u_simParams.w, 0.0);
    float velFactor = drag < 0.0001 ? t : (1.0 - exp(-drag * t)) / drag;
    // Gravity integrated analytically; linear drag applies to initial velocity.
    vec3 position = In.position.xyz + In.normal.xyz * velFactor
        + 0.5 * u_gravity.xyz * t * t;
    vec3 world = (matWorld * vec4(position, 1.0)).xyz;
    vec3 velocityWorld = mat3(matWorld) * (In.normal.xyz + u_gravity.xyz * t);
    // Optional single-bounce analytic collision with world-space horizontal plane.
    // This uses a ballistic trajectory (drag is intentionally ignored for
    // collision timing) and resolves only the first downward impact per cycle.
    if (u_collisionPlane.x > 0.5) {
      vec3 startWorld = (matWorld * vec4(In.position.xyz, 1.0)).xyz;
      vec3 initialVelocity = mat3(matWorld) * In.normal.xyz;
      vec3 gravityWorld = mat3(matWorld) * u_gravity.xyz;
      float height = u_collisionPlane.y;
      float g = gravityWorld.y;
      float vy = initialVelocity.y;
      float d = startWorld.y - height;
      float impactTime = -1.0;
      if (d >= 0.0) {
        if (abs(g) < 0.00001) {
          if (vy < -0.00001) impactTime = -d / vy;
        } else {
          float discriminant = vy * vy - 2.0 * g * d;
          if (discriminant >= 0.0) {
            float root = (-vy - sqrt(discriminant)) / g;
            float root2 = (-vy + sqrt(discriminant)) / g;
            if (root >= 0.0 && vy + g * root < 0.0) impactTime = root;
            if (root2 >= 0.0 && vy + g * root2 < 0.0
                && (impactTime < 0.0 || root2 < impactTime)) impactTime = root2;
          }
        }
      }
      if (impactTime >= 0.0 && t >= impactTime) {
        float remaining = t - impactTime;
        vec3 impact = startWorld + initialVelocity * impactTime
            + 0.5 * gravityWorld * impactTime * impactTime;
        impact.y = height;
        vec3 reboundVelocity = initialVelocity + gravityWorld * impactTime;
        reboundVelocity.y = -reboundVelocity.y * clamp(u_collisionPlane.z, 0.0, 1.0);
        world = impact + reboundVelocity * remaining
            + 0.5 * gravityWorld * remaining * remaining;
        world.y = max(height, world.y);
        velocityWorld = reboundVelocity + gravityWorld * remaining;
        if (world.y <= height + 0.0001 && velocityWorld.y < 0.0) velocityWorld.y = 0.0;
      }
    }
    // M5.2: swept sphere contact along eight ballistic trajectory chords.
    // Approximate continuous collision for gravity trajectories; exact for
    // straight-line motion. Resolve the first entering hit only.
    if (u_sphereParams.x > 0.5 && u_sphereParams.y > 0.0001) {
      vec3 sphereCenter = u_collisionSphere.xyz;
      float radius = u_sphereParams.y;
      vec3 startWorld = (matWorld * vec4(In.position.xyz, 1.0)).xyz;
      vec3 initialVelocity = mat3(matWorld) * In.normal.xyz;
      vec3 gravityWorld = mat3(matWorld) * u_gravity.xyz;
      if (dot(startWorld - sphereCenter, startWorld - sphereCenter) > radius * radius) {
        float impactTime = -1.0;
        vec3 contactPoint = startWorld;
        const int STEPS = 8;
        float stepTime = max(0.001, life / float(STEPS));
        for (int j = 0; j < STEPS; ++j) {
          float t0 = float(j) * stepTime;
          float t1 = min(life, t0 + stepTime);
          vec3 a = startWorld + initialVelocity * t0 + 0.5 * gravityWorld * t0 * t0;
          vec3 b = startWorld + initialVelocity * t1 + 0.5 * gravityWorld * t1 * t1;
          vec3 segment = b - a;
          vec3 offset = a - sphereCenter;
          float A = dot(segment, segment);
          float B = 2.0 * dot(offset, segment);
          float C = dot(offset, offset) - radius * radius;
          float disc = B * B - 4.0 * A * C;
          if (A > 0.0000001 && disc >= 0.0) {
            float k = (-B - sqrt(disc)) / (2.0 * A);
            if (k >= 0.0 && k <= 1.0) {
              impactTime = mix(t0, t1, k);
              contactPoint = a + segment * k;
              break;
            }
          }
        }
        if (impactTime >= 0.0 && t >= impactTime) {
          float remaining = t - impactTime;
          vec3 normal = normalize(contactPoint - sphereCenter);
          vec3 incoming = initialVelocity + gravityWorld * impactTime;
          vec3 bounced = incoming - (1.0 + clamp(u_sphereParams.z, 0.0, 1.0))
              * min(dot(incoming, normal), 0.0) * normal;
          world = contactPoint + bounced * remaining
              + 0.5 * gravityWorld * remaining * remaining;
          velocityWorld = bounced + gravityWorld * remaining;
        }
      }
    }
    // View matrix rows represent camera right and up in world space.
    vec3 right = vec3(cc_matView[0][0], cc_matView[1][0], cc_matView[2][0]);
    vec3 up = vec3(cc_matView[0][1], cc_matView[1][1], cc_matView[2][1]);
    float size = u_simParams.z;
    vec3 quadUp = up;
    float stretch = 1.0;
    if (u_stretchParams.x > 0.5) {
      vec3 projectedVelocity = velocityWorld - dot(velocityWorld, normalize(cc_cameraPos.xyz - world)) * normalize(cc_cameraPos.xyz - world);
      float projectedSpeed = length(projectedVelocity);
      if (projectedSpeed > 0.0001) {
        quadUp = projectedVelocity / projectedSpeed;
        vec3 viewDir = normalize(cc_cameraPos.xyz - world);
        right = normalize(cross(quadUp, viewDir));
        // Clamp the speed (physical input), not speed * factor. The old
        // 10x output cap made factors 1 and 3 look identical once falling
        // particles accelerated under gravity.
        float speedForStretch = min(projectedSpeed, 20.0);
        stretch = 1.0 + speedForStretch * 0.25 * max(0.0, u_stretchParams.y);
      }
    }
    world += (right * a_texCoord.x + quadUp * a_texCoord.y * stretch) * (0.5 * size);
    v_uv = a_texCoord * 0.5 + 0.5;
    float normalizedAge = age / life;
    v_alpha = smoothstep(0.0, 0.1, normalizedAge)
            * (1.0 - smoothstep(0.75, 1.0, normalizedAge));
    return cc_matProj * cc_matView * vec4(world, 1.0);
  }
}%

CCProgram gpu-particle-fs %{
  precision highp float;
  #include <legacy/output>
  uniform ParticleData {
    vec4 u_simParams;
    vec4 u_gravity;
    vec4 mainColor;
    vec4 u_stretchParams;
    vec4 u_collisionPlane;
    vec4 u_collisionSphere;
    vec4 u_sphereParams;
  };
  in vec2 v_uv;
  in float v_alpha;

  vec4 frag () {
    vec2 p = v_uv * 2.0 - 1.0;
    float radial = clamp(1.0 - dot(p, p), 0.0, 1.0);
    return CCFragOutput(vec4(mainColor.rgb, mainColor.a * radial * v_alpha));
  }
}%
