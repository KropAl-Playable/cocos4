// Task 005 M5.1 analytical billboard shader. WebGL2 path only.
// a_position: local spawn position; a_normal: initial velocity;
// a_texCoord: quad corner (-1..1); a_tangent.x: birth phase (0..1).
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: gpu-particle-vs:vert
      frag: gpu-particle-fs:frag
      phase: default
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        u_simParams: { value: [0, 3, 0.05, 0], editor: { visible: false } }
        u_gravity: { value: [0, -9.8, 0, 0], editor: { visible: false } }
        mainColor: { value: [1, 0.8, 0.3, 1], editor: { type: color } }
}%

CCProgram gpu-particle-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  uniform ParticleData {
    vec4 u_simParams;  // time, lifetime, size, drag
    vec4 u_gravity;
    vec4 mainColor;
  };

  out vec2 v_uv;
  out float v_alpha;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    float life = max(u_simParams.y, 0.001);
    float age = mod(max(u_simParams.x + In.tangent.x * life, 0.0), life);
    float t = age;
    float drag = max(u_simParams.w, 0.0);
    float velFactor = drag < 0.0001 ? t : (1.0 - exp(-drag * t)) / drag;
    // Gravity integrated analytically; linear drag applies to initial velocity.
    vec3 position = In.position.xyz + In.normal.xyz * velFactor
        + 0.5 * u_gravity.xyz * t * t;
    vec3 world = (matWorld * vec4(position, 1.0)).xyz;
    // View matrix rows represent camera right and up in world space.
    vec3 right = vec3(cc_matView[0][0], cc_matView[1][0], cc_matView[2][0]);
    vec3 up = vec3(cc_matView[0][1], cc_matView[1][1], cc_matView[2][1]);
    float size = u_simParams.z;
    world += (right * a_texCoord.x + up * a_texCoord.y) * (0.5 * size);
    v_uv = a_texCoord * 0.5 + 0.5;
    float normalizedAge = age / life;
    v_alpha = smoothstep(0.0, 0.1, normalizedAge)
            * (1.0 - smoothstep(0.75, 1.0, normalizedAge));
    return cc_matProj * cc_matView * vec4(world, 1.0);
  }
}%

CCProgram gpu-particle-fs %{
  precision mediump float;
  #include <legacy/output>
  uniform ParticleData {
    vec4 u_simParams;
    vec4 u_gravity;
    vec4 mainColor;
  };
  in vec2 v_uv;
  in float v_alpha;

  vec4 frag () {
    vec2 p = v_uv * 2.0 - 1.0;
    float radial = clamp(1.0 - dot(p, p), 0.0, 1.0);
    return CCFragOutput(vec4(mainColor.rgb, mainColor.a * radial * v_alpha));
  }
}%
