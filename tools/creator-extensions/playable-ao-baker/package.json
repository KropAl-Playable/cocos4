{
  "package_version": 2,
  "version": "0.1.0",
  "name": "playable-ao-baker",
  "title": "Playable AO Baker",
  "description": "Editor-only vertex AO baking tools for the COCOS 4 playable runtime fork.",
  "author": "KropAl-Playable",
  "editor": ">=3.8.0 <3.9.0",
  "main": "./dist/main.js",
  "panels": {
    "default": {
      "title": "Playable AO Baker",
      "type": "dockable",
      "main": "./dist/panels/default/index.js",
      "size": {
        "min-width": 320,
        "min-height": 520,
        "width": 380,
        "height": 640
      }
    }
  },
  "contributions": {
    "scene": {
      "script": "./dist/scene.js"
    },
    "menu": [
      {
        "path": "Playable Tools",
        "label": "AO Baker",
        "message": "open"
      }
    ],
    "messages": {
      "open": {
        "methods": ["open"]
      },
      "query-selection": {
        "methods": ["querySelection"]
      },
      "preview": {
        "methods": ["preview"]
      },
      "bake": {
        "methods": ["bake"]
      },
      "restore": {
        "methods": ["restore"]
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8",
    "@types/node": "^18.0.0",
    "typescript": "^4.9.5"
  }
}
