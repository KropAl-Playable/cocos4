{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cocos/creator-types/engine",
      "@cocos/creator-types/editor"
    ]
  },
  "include": [
    "src/**/*.ts",
    "@types/**/*.d.ts"
  ]
}
