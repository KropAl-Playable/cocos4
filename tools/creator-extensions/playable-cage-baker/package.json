{
  "package_version": 2,
  "version": "0.1.0",
  "name": "playable-cage-baker",
  "title": "Playable Cage Baker",
  "description": "Editor-only cage influence baking tools for the COCOS 4 playable runtime fork.",
  "author": "KropAl-Playable",
  "editor": ">=3.8.0 <3.9.0",
  "main": "./dist/main.js",
  "panels": {
    "default": {
      "title": "Playable Cage Baker",
      "type": "dockable",
      "main": "./dist/panels/default/index.js",
      "size": {
        "min-width": 260,
        "min-height": 280,
        "width": 360,
        "height": 430
      }
    }
  },
  "contributions": {
    "scene": {
      "script": "./dist/scene.js"
    },
    "menu": [
      {
        "path": "Playable Tools",
        "label": "Cage Baker",
        "message": "open"
      }
    ],
    "messages": {
      "open": {
        "methods": [
          "open"
        ]
      },
      "query-selection": {
        "methods": [
          "querySelection"
        ]
      },
      "bake": {
        "methods": [
          "bake"
        ]
      },
      "bake-current": {
        "methods": [
          "bakeCurrent"
        ]
      }
    },
    "inspector": {
      "section": {
        "node": {
          "cc.CageDeformer": "./dist/contributions/inspector/cage-deformer.js"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8",
    "@types/node": "^18.0.0",
    "typescript": "^4.9.5"
  }
}
